# IKIGAI — canonical environment template (serverless scope, ADR-037)
#
# Copy this file to `.env` at the repo root and fill in the real values.
# `.env` is gitignored and MUST never be committed.
#
# Every variable below is read by published code. Nothing here belongs to the
# retired local harness (LangChain / LangGraph / OpenTelemetry / LangSmith /
# Langfuse): that stack left the canonical scope with the serverless pivot, so
# the tracing template that used to live here is gone for good.
#
# Secrets that were committed (or echoed) before the pivot were purged from the
# git history by `git filter-repo`. Treat every key that ever appeared in this
# repository as compromised and rotate it at the provider; placeholders below
# are for NEW keys only.

# ---------------------------------------------------------------------------
# MCP transport — the public interface of the system (ADR-011)
# ---------------------------------------------------------------------------
# stdio (default) | http | streamable-http | sse
IKIGAI_MCP_TRANSPORT=stdio
# Host/port used by the HTTP transports (FastMCP reads the FASTMCP_* prefix).
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000

# ---------------------------------------------------------------------------
# Data layer
# ---------------------------------------------------------------------------
# Root of the runtime state (SQLite / chroma / boulder) — relative to the repo.
IKIGAI_DATA_DIR=data

# Gateway (fork bridge). The retired fork clients were purged with the pivot;
# the gateway itself remains the local bridge surface.
IKIGAI_GATEWAY_HOST=127.0.0.1
IKIGAI_GATEWAY_PORT=8765

# Emergency stop — any value other than "1" leaves the system running.
# IKIGAI_KILL_SWITCH=1

# ---------------------------------------------------------------------------
# Taskdog fork adapter (src/mesh/adapters/taskdog.py)
# ---------------------------------------------------------------------------
TASKDOG_SERVER=http://127.0.0.1:8000
TASKDOG_HTTP_TIMEOUT=3.0
TASKDOG_HTTP_ENABLED=1

# ---------------------------------------------------------------------------
# Notifications (interfaces/cli/notify.py)
# ---------------------------------------------------------------------------
# Both are required for Telegram delivery; without them the CLI only logs.
# TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID=PASTE_YOUR_TELEGRAM_CHAT_ID
NOTIFY_VERBOSE=0
# NOTIFY_FILE=logs/notifications.log

# ---------------------------------------------------------------------------
# Life meta-package logs (life/cli/config.py)
# ---------------------------------------------------------------------------
# LIFE_LOG_DIR=.life/logs

# ---------------------------------------------------------------------------
# Reflection planner (src/agents/reflection/recursive.py)
# ---------------------------------------------------------------------------
# REFLECT_TODAY=2026-11-01
# REFLECT_LOOKBACK_DAYS=14

# ---------------------------------------------------------------------------
# LLM judge for the backtest corpus (tools/backtest/llm_judge.py)
# ---------------------------------------------------------------------------
# Only needed to run the LLM-judged backtest; the corpus runs with
# IKIGAI_FAKE_LLM=1 otherwise.
# ANTHROPIC_API_KEY=PASTE_YOUR_KEY_HERE
# CLAUDE_API_KEY=PASTE_YOUR_KEY_HERE
# MINIMAX_API_KEY=PASTE_YOUR_KEY_HERE
# IKIGAI_MODEL=MiniMax-M2.7-highspeed

# ---------------------------------------------------------------------------
# GitHub automation (.github/scripts/project_board.py)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=PASTE_YOUR_GITHUB_TOKEN
