# =============================================================================
# IKIGAI Runtime Environment
# Copy to .env and adjust for your environment.
# All IKIGAI tools respect these env vars at startup.
# =============================================================================

# LLM Mode (required for CI / $0 tick)
# Set to 1 to use fake LLM responses (no actual API calls).
# All Phase 8 v2 graph nodes + IKIGAI MCP tools respond with canned
# stub data so `make test` and loop-tick runs cost $0.
# Uncomment for CI, tick, and local dev without OpenAI/Anthropic keys:
# IKIGAI_FAKE_LLM=1

# Notification Webhook (optional - M8 ntfy.sh integration)
# Loop-tick sends a webhook on EXIT (FAIL/NEEDS_FIX/BLOCKED/OVERRUN/
# BUDGET_ABORT/spike_alarm) via ntfy.sh. Leave empty to disable.
# Example (comment to disable):
# LOOP_NOTIFY_TOPIC=https://ntfy.sh/my-loop-alerts
LOOP_NOTIFY_TOPIC=

# PYTHONPATH - 3-entry format for worktree isolation (Phase 8.4)
# Required when running from a worktree where src/ (dotted-prefix packages)
# and sys_ikigai/ (bare-namespace packages) are not auto-resolved.
# For a worktree at <WORKTREE_ROOT>, the 3 entries are:
#   <WORKTREE_ROOT>/life        - repo root (for sys_ikigai.*)
#   <WORKTREE_ROOT>/life/src  - dotted-prefix packages (src.contracts.*)
#   <WORKTREE_ROOT>           - for sibling imports if needed
#
# Windows example:
# PYTHONPATH=C:\Users\mathe\code_space\life-oss;C:\Users\mathe\code_space\life-oss\life\src;C:\Users\mathe\code_space\life-oss\life
