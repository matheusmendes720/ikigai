# IKIGAI — canonical environment template (ADR-037, renewed scope 2026-11-02)
#
# Copy this file to `.env` at the repository root (or to `deploy/.env` when
# the compose stack is what you are starting) and fill in the real values.
# `.env` is gitignored and MUST never be committed.
#
# Every variable below is read by PUBLISHED code. Nothing here belongs to the
# retired local harness (LangChain / LangGraph / OpenTelemetry / the fork
# mesh / the taskdog bridge / the paperclip spawner): that stack left the
# canonical scope with the serverless pivot, and its variables are gone for
# good. The gateway, the taskdog adapter, the notification CLI, the
# reflection planner and the backtest judge no longer exist — the template
# that listed them described a service that is not published any more.
#
# Secrets that were committed (or echoed) before the pivot were purged from
# the git history by `git filter-repo`. Treat every key that ever appeared in
# this repository as compromised and rotate it at the provider; placeholders
# below are for NEW keys only.

# ---------------------------------------------------------------------------
# The store — the one thing the service cannot work without
# ---------------------------------------------------------------------------
# The DSN of the Postgres that holds the DOM. It comes from the environment
# and NEVER from a file: `DataClient` refuses to start without it, and the
# message says so. The schema is `ikig`; the migrations live in
# `src/contracts/migrations/`.
#
#   local compose:  postgresql://ikigai:<password>@db:5432/ikigai
#   your own box:   postgresql://<user>:<password>@<host>:5432/<database>
IKIGAI_STORE_DSN=

# ---------------------------------------------------------------------------
# MCP transport — the public interface of the system (ADR-011)
# ---------------------------------------------------------------------------
# stdio (default) | http | streamable-http | sse
IKIGAI_MCP_TRANSPORT=stdio
# The address and port the HTTP transports bind. These are read by THIS
# repository and handed to FastMCP's constructor — FastMCP itself reads no
# environment variable for them, and its default host is the loopback. A
# container must set 0.0.0.0 or nothing can reach it from another container.
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000

# ---------------------------------------------------------------------------
# The websocket — the sync channel (ADR-039)
# ---------------------------------------------------------------------------
# The address and port the websocket binds, and the token a client must
# present. The token is REQUIRED: the channel is a write path, and the server
# refuses to start without one (unless IKIGAI_WS_ALLOW_ANONYMOUS=1, which is
# an explicit opt-out and not a default).
# IKIGAI_WS_HOST=127.0.0.1
# IKIGAI_WS_PORT=8001
# IKIGAI_WS_TOKEN=PASTE_A_RANDOM_SECRET
# The websocket endpoint, as the bot sees it. When it is set, the bot uses it
# and receives what the store changed.
# IKIGAI_WS_URL=http://ws:8001/sync

# ---------------------------------------------------------------------------
# The embeddings — what the vector index is made of (ADR-039)
# ---------------------------------------------------------------------------
# `local` (default) is a deterministic hashing trick: no key, no network, and
# NOT semantic. `openai` is any OpenAI-compatible `/embeddings` endpoint, and
# it is what makes the semantic search mean something. The width must be the
# one the column holds — 1536.
# IKIGAI_EMBEDDING_PROVIDER=local
# IKIGAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# IKIGAI_EMBEDDING_MODEL=text-embedding-3-small
# IKIGAI_EMBEDDING_API_KEY=PASTE_YOUR_KEY

# ---------------------------------------------------------------------------
# The ingestion — the vault prose into the store (ADR-039)
# ---------------------------------------------------------------------------
# How often it runs, in seconds, and where it reads. Each tree is
# `<path>=<layout>`, and the layout is `closing` or `persona`.
# IKIGAI_VAULT_SYNC_INTERVAL=60
# IKIGAI_VAULT_ROOTS=/app/vault/ikigai/closing-2026=closing

# ---------------------------------------------------------------------------
# The bot — the first non-desktop client (ADR-037 D8)
# ---------------------------------------------------------------------------
# The Telegram bot token, and the owner chat ids allowed to use it. The
# allowlist is REQUIRED: without it the bot refuses to start rather than
# answering anyone who finds the token (contract C-4).
# IKIGAI_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN
# IKIGAI_BOT_ALLOWED_CHAT_IDS=123456789
# The api's MCP endpoint, as the client sees it.
# IKIGAI_MCP_URL=http://localhost:8000/mcp
# The identity written on every write — the claim the RLS policies filter on.
# IKIGAI_CLIENT_ID=owner
# The AGENT's door, as the bot sees it. When it is set, the bot can run the
# cadences: the owner asks for one and the harness runs it. It is NOT
# required — without it the bot still writes, searches and reads, and the
# routines are refused with a reason.
# IKIGAI_HARNESS_URL=http://harness:8002
# The ceiling of a routine, in seconds. The harness bounds the run with the
# same number, so the two agree on who gives up first — the agent, not the
# socket.
# IKIGAI_HARNESS_TIMEOUT_S=600

# ---------------------------------------------------------------------------
# The harness — the `pi` agent, in a container (ADR-037 D7)
# ---------------------------------------------------------------------------
# The agent is EXTERNAL: it runs in its own container, with its own runtime,
# and it reaches the store through the api's MCP — never through a DSN. The
# provider is a COMPATIBLE ENDPOINT, so the container talks to whatever the
# operator points it at (a vendor, a proxy, a self-hosted gateway) without a
# rebuild.
#
# The api key is NOT an entry in this file. It is a compose SECRET backed by a
# file, because an environment entry is not a secret store: the engine keeps it
# in the container's `Config.Env` (so `docker inspect` prints it) and in
# `/proc/1/environ` inside the container, where every process the agent spawns
# inherits it. Measured on the box before the change: the key was one
# `docker inspect` away from anyone allowed to run `docker` there.
#
# Write it ONCE, outside the repository:
#
#   mkdir -p deploy/secrets
#   install -m 600 /dev/null deploy/secrets/harness_provider_key
#   printf '%s' 'PASTE_YOUR_PROVIDER_KEY' > deploy/secrets/harness_provider_key
#
# `printf '%s'` and not `echo`: a trailing newline is invisible in the file and
# fatal in an `Authorization` header. `deploy/secrets/` is gitignored.
#
# HARNESS_PROVIDER_ID=harness
# HARNESS_PROVIDER_BASE_URL=https://api.minimax.io/anthropic
# HARNESS_PROVIDER_API=anthropic-messages
# HARNESS_MODEL_ID=MiniMax-M2.7
# How many `pi` processes may live at once (one per session), and how long
# an idle session is kept before the process is evicted.
# HARNESS_MAX_SESSIONS=8
# HARNESS_SESSION_TTL_MS=900000
# The ceiling of one routine, in milliseconds.
# HARNESS_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# The compose stack's database (deploy/compose.yml)
# ---------------------------------------------------------------------------
# These name the Postgres the compose file starts. The password is required:
# the compose refuses to start without it.
# IKIGAI_DB_NAME=ikigai
# IKIGAI_DB_USER=ikigai
# IKIGAI_DB_PASSWORD=PASTE_YOUR_DB_PASSWORD
# The image the stack runs. The CI/CD workflow sets it to the tag it
# published; leave it unset for a local build.
# IKIGAI_IMAGE=ghcr.io/matheusmendes720/ikigai:latest

# ---------------------------------------------------------------------------
# GitHub automation (.github/scripts/project_board.py)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=PASTE_YOUR_GITHUB_TOKEN
