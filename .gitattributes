# ─── Line ending policy ──────────────────────────────────────────
# Windows batch files require CRLF; cmd.exe misparses `if () (...)`
# multi-line constructs when the file has only LF.
#
# Without this attribute, `core.autocrlf=true` (set globally on many
# Windows dev boxes) silently converts CRLF→LF on commit, undoing
# any local fix. Force CRLF storage for batch files so the fix
# survives `git clone`, `git checkout`, and `git pull`.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# A shell script is the other way round: bash reads the shebang LINE, and a
# CRLF checkout leaves a "\r" on it — "#!/usr/bin/env bash\r" is not an
# interpreter path, and the script dies with "bad interpreter" on the first
# run. The deployment scripts (the backup, the restore) are run by cron on a
# Linux box, from a clone that a Windows contributor may have produced.
*.sh    text eol=lf

# Git reads the ignore rules BYTE FOR BYTE, and a CRLF checkout changes what
# it decides. A pattern that ends in "/" is a DIRECTORY rule, and the "\r"
# that CRLF leaves at the end of the line is part of the pattern — so the
# directory rule stops matching. Then the last rule that matches decides, and
# on a Windows clone that is not the rule that decides on Linux:
#
#     LF   : data/test-fixtures/  ->  addable
#     CRLF : data/test-fixtures/  ->  IGNORED
#
# The same ignore file, two verdicts, two machines — and the verdict decides
# whether a file can be tracked at all. The rules live in the repository, not
# in a developer's checkout, so they are held in one shape everywhere.
.gitignore    text eol=lf
.gitattributes text eol=lf
