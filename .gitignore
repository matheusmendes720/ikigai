# ─── Agent runtime state ─────────────────────────────────────────
.pi/
.atl/
.life/

# ─── Stray paths from shell-quote bugs ──────────────────────────
# Literal-tilde dirs (e.g. `~/` typed in a path that was replayed
# as a literal string → `src/ikigai/~/.ikigai/*.db` was tracked).
# These are NOT user-home expansions; treat `~` as a path component.
**/~/**
**/~*.db
# Stray zero-byte / one-char / shell-quote-garbage files at repo root.
# These came from malformed bash redirection (e.g. `> agent('Execute')`).
# Listed individually because gitignore glob character classes can't
# reliably match quotes/backticks/brackets across shells.
# Examples seen 2026-08-28: '  `  -  0  6.0  None  For  d.classification  list[object]  s.docs

# ─── Vault (Obsidian KB — runtime only) ─────────────────────────
# Source vault (wikilinks, markdown) IS tracked.
# Runtime artifacts inside vault/ are ignored.
vault/.venv/
vault/__pycache__/
vault/.ruff_cache/
vault/.mypy_cache/
vault/.pytest_cache/

# ─── BYD D2 Plotly HTMLs (regenerable artifacts) ────────────────
# 6 Plotly HTMLs at ~4.85 MB each = 27.88 MB committed. Regenerable
# from src/ikigai/data/matheus/deliverables/byd-d2-outputs/{byd-econometric-vulnerability.py,.ipynb}.
# Source files (.py, .ipynb, 1-pager-summary.md) stay tracked.
src/ikigai/data/matheus/**/outputs/*.html

# ─── Editor & OS ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store

# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# ─── All venvs (uv + poetry) ─────────────────────────────────────
**/.venv/
**/__pycache__/
**/.ruff_cache/
**/.mypy_cache/
**/.pytest_cache/

# ─── Test / coverage ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ─── Runtime Data Layer ───────────────────────────────────────────
# All mutable runtime state: SQLite, Chroma, boulder JSON, session logs
data/*.db
data/*.json
data/*.jsonl
data/chroma_db/
data/*.log
data/session-*.md
data/*-sessions/
logs/
*.log

# ─── Build artifacts ──────────────────────────────────────────────
life-ops/operational/.venv/
life-ops/operational/dist/
life-ops/operational/build/
life-ops/operational/*.egg-link
life-ops/operational/.pytest_cache/
.pytest-tmp/
vibe-ops/.venv/
vibe-ops/__pycache__/
vibe-ops/.ruff_cache/
vibe-ops/.mypy_cache/
vibe-ops/.pytest_cache/

# ─── Go build artifacts (medic) ──────────────────────────────────
# First-party Go tool at src/operational/medic/ (module github.com/life-oss/medic).
# 2026-08-28 audit: 24 MB of committed .exe was inflating every clone.
# Source (.go, go.mod, go.sum) IS tracked; binaries are local build outputs.
# Per structure-audit-2026-08-28 §HIGH "verify-medic-claim" finding.
src/operational/medic/medic.exe
src/operational/medic/bin/

# ─── Node (GitNexus runner) ──────────────────────────────────────
node_modules/
.gitnexus/cache/

# ─── OpenWiki runtime state ───────────────────────────────────────
.openwiki/
openwiki/.run.json
openwiki/.last-update.json.tmp

# ─── Session archives (moved to data/) ───────────────────────────
# Kept in .gitignore so they don't creep back to root
session-ses_*.md
2026-*-sessions/
*-sessions/
