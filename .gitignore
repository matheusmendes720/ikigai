/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/helpers/.helpers-version
/.claude/helpers/helpers.manifest.json
/src/ikigai/.claude-flow/
/src/ikigai/.claude/
/.omh/goals/
/.claude/loop/logs/
/.swarm/backups/
/.swarm/*.db
