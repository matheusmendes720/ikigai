# ─── Agent runtime state ─────────────────────────────────────────
.pi/
.atl/
.life/

# ─── Stray paths from shell-quote bugs ──────────────────────────
# Literal-tilde dirs (e.g. `~/` typed in a path that was replayed
# as a literal string → `src/ikigai/~/.ikigai/*.db` was tracked).
# These are NOT user-home expansions; treat `~` as a path component.
**/~/**
**/~*.db
# Stray zero-byte / one-char / shell-quote-garbage files at repo root.
# These came from malformed bash redirection (e.g. `> agent('Execute')`).
# Listed individually because gitignore glob character classes can't
# reliably match quotes/backticks/brackets across shells.
# Examples seen 2026-08-28: '  `  -  0  6.0  None  For  d.classification  list[object]  s.docs
# Examples seen 2026-08-29: '  2  6  None  com  dict[str  formal  one  str  Algorítmica
# Root-level bare digits (bash > digit bugs)
/[0-9]
# Root-level files starting with shell-special chars (', [, {, `)
/['\[\{`]
# Root-level Python keyword / short-token names that appear from
# malformed redirect targets. Listed individually — gitignore does
# not support alternation `(a|b)` or braces `{a,b}` in match patterns.
/None
/str
/int
/float
/bool
/list
/dict
/com
/formal
/one
# Root-level type-annotation fragments (e.g. `dict[str`, `list[object]`).
# `\[` matches one literal `[`; `*` matches the rest. Without `*` the
# pattern would only match the prefix without the bracket content.
/dict\[*
/list\[*
/tuple\[*
/set\[*
/frozenset\[*

# Root-level test DB created by vibe-ops/scripts/test_mvl_ingestion.py
# whose cleanup line is commented out. Different schema (5 tables, ORM)
# from canonical data/vibe_ops.db (19 tables). No production refs.
/vibe_ops_test.db

# vibe-ops/ test artifacts (left behind by ad-hoc scripts whose cleanup
# is commented out). Pre-existing tracked files were untracked in B5.5
# (`git rm --cached`); this pattern prevents future re-tracking.
# `data/*.db` (canonical runtime state) is a separate pattern.
vibe-ops/**/*.db

# ─── Vault (Obsidian KB — runtime only) ─────────────────────────
# Source vault (wikilinks, markdown) IS tracked.
# Runtime artifacts inside vault/ are ignored.
vault/.venv/
vault/__pycache__/
vault/.ruff_cache/
vault/.mypy_cache/
vault/.pytest_cache/
vault/.db

# ─── BYD D2 Plotly HTMLs (regenerable artifacts) ────────────────
# 6 Plotly HTMLs at ~4.85 MB each = 27.88 MB committed. Regenerable
# from src/ikigai/data/matheus/deliverables/byd-d2-outputs/{byd-econometric-vulnerability.py,.ipynb}.
# Source files (.py, .ipynb, 1-pager-summary.md) stay tracked.
src/ikigai/data/matheus/**/outputs/*.html

