# =============================================================================
# IKIGAI Runtime Environment — Production Configuration
# =============================================================================

# LLM Mode (required for CI / $0 tick)
# Set to 1 to use fake LLM responses (no actual API calls).
# All Phase 8 v2 graph nodes + IKIGAI MCP tools respond with canned
# stub data so `make test` and loop-tick runs cost $0.
# Uncomment for CI, tick, and local dev without OpenAI/Anthropic keys:
IKIGAI_FAKE_LLM=1

# Anthropic API (MiniMax proxy — your existing setup per Phase 8.9)
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# Replace with your actual key when ready to use real LLM:
ANTHROPIC_API_KEY=your-key-here

# Notification Webhook (optional - M8 ntfy.sh integration)
# Loop-tick sends a webhook on EXIT (FAIL/NEEDS_FIX/BLOCKED/OVERRUN/
# BUDGET_ABORT/spike_alarm) via ntfy.sh. Leave empty to disable.
LOOP_NOTIFY_TOPIC=

# PYTHONPATH - 3-entry format for worktree isolation (Phase 8.4)
# Required when running from a worktree where src/ (dotted-prefix packages)
# and sys_ikigai/ (bare-namespace packages) are not auto-resolved.
# For a worktree at <WORKTREE_ROOT>, the 3 entries are:
#   <WORKTREE_ROOT>/life        - repo root (for sys_ikigai.*)
#   <WORKTREE_ROOT>/life/src  - dotted-prefix packages (src.contracts.*)
#   <WORKTREE_ROOT>           - for sibling imports if needed
#
# Windows example:
PYTHONPATH=C:\Users\mathe\code_space\life-oss;C:\Users\mathe\code_space\life-oss\life\src;C:\Users\mathe\code_space\life-oss\life

# OpenTelemetry OTLP Exporter (optional - T-3 Phase 8.3 observability)
# Enable a generic OTLP HTTP exporter for any OTEL-compatible collector
# (LangSmith, Langfuse, Grafana Tempo, Jaeger, etc.).
# LAZY: the exporter is only wired when OTEL_EXPORTER_OTLP_ENDPOINT is set;
# no-op if absent so local dev without a collector works fine.
#
# Endpoint (required to enable):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# Optional auth headers (comma-separated key=value pairs):
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=your-key,other-header=value

# Cost guard rails (PROD-3): per-skill token caps
# IKIGAI_MAX_TOKENS_DAILY=1000
# IKIGAI_MAX_TOKENS_WEEKLY=8000
# IKIGAI_MAX_TOKENS_MONTHLY=32000
# IKIGAI_MAX_TOKENS_QUARTERLY=96000

# Rate limit (PROD-3): maximum invoke_skill calls per hour (simple in-memory token bucket)
# IKIGAI_RATE_LIMIT=10
