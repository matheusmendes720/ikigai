# IKIGAI Observability — environment template
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# DO NOT commit real secrets. The previous key
#   REMOVE_ME_PENDING_SECRET_INPUT
# leaked in ~/.claude/history.jsonl:2497 — rotate it first at
#   https://smith.langchain.com/settings/api-keys
# before populating the values below.

# ---------------------------------------------------------------------------
# LangSmith — primary LLM observability backend
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_REPLACE_ME_WITH_ROTATED_KEY
LANGSMITH_PROJECT=ikigai
LANGSMITH_OTEL_ENABLED=true

# Optional override of the OTLP endpoint (default is the public LangSmith OTLP ingest)
# LANGSMITH_OTEL_ENDPOINT=https://api.smith.langchain.com/api/v1/otel/v1/traces

# ---------------------------------------------------------------------------
# Langfuse — secondary stack-trace + custom-event backend
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf_REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf_REPLACE_ME
# EU (default). For US, use https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# OpenTelemetry — service identification
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=ikigai-maintainer
IKIGAI_ENV=local
